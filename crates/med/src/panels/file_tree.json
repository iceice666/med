{
  "type": "col",
  "style": {
    "width": "full",
    "height": "full",
    "bg": "sidebar",
    "color": "sidebar_foreground"
  },
  "children": [
    {
      "type": "row",
      "style": {
        "height": 32,
        "shrink": false,
        "padding_x": 12,
        "align": "center",
        "border_bottom": 1,
        "border_color": "sidebar_border",
        "color": "muted_foreground",
        "bold": true
      },
      "when": [
        { "if": ["focused"], "style": { "color": "sidebar_foreground" } }
      ],
      "children": [{ "type": "text", "text": "{root_name}" }]
    },
    {
      "type": "list",
      "source": "entries",
      "style": { "grow": true },
      "item": {
        "type": "row",
        "style": {
          "height": 24,
          "width": "full",
          "align": "center",
          "padding_left": { "base": 10, "step": 14, "times": "depth" },
          "padding_right": 8,
          "nowrap": true
        },
        "when": [
          { "if": ["modified"], "style": { "color": "warning" } },
          { "if": ["added"], "style": { "color": "success" } },
          { "if": ["selected", "!focused"], "style": { "bg": "list_hover" } },
          { "if": ["selected", "focused"], "style": { "bg": "list_active" } }
        ],
        "hover": { "bg": "list_hover" },
        "on_click": "tree.open",
        "children": [
          {
            "type": "text",
            "if": ["dir", "expanded"],
            "text": "▾ ",
            "style": { "color": "muted_foreground" }
          },
          {
            "type": "text",
            "if": ["dir", "!expanded"],
            "text": "▸ ",
            "style": { "color": "muted_foreground" }
          },
          {
            "type": "text",
            "if": ["!dir"],
            "text": "  ",
            "style": { "color": "muted_foreground" }
          },
          { "type": "text", "text": "{name}" }
        ]
      }
    }
  ]
}
