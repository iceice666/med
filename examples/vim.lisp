; The vim layout: the keys of vim's modes, each bound to one of the vim
; engine's commands. med binds no key by itself, so an init file with
; none of this is an editor where no key does anything: load this file,
; or copy it beside your `init.lisp` and change what you like.
;
;   (load "/path/to/med/examples/vim.lisp")
;
; What stays in the engine is vim's grammar: counts, registers, an
; operator and then a motion or text object, the doubled operator (`dd`).
; It works the same whatever keys these are. The modes are `normal`,
; `visual`, `operator` (after an operator, before its motion) and
; `insert`; a list binds the keys in each of them.

; Motions: on their own, and after an operator.
(bind '(normal visual operator) "h" "motion.left")
(bind '(normal visual operator) "<Left>" "motion.left")
(bind '(normal visual operator) "<BS>" "motion.left")
(bind '(normal visual operator) "<C-h>" "motion.left")
(bind '(normal visual operator) "l" "motion.right")
(bind '(normal visual operator) "<Right>" "motion.right")
(bind '(normal visual operator) "<Space>" "motion.right")
(bind '(normal visual operator) "j" "motion.down")
(bind '(normal visual operator) "<Down>" "motion.down")
(bind '(normal visual operator) "<C-j>" "motion.down")
(bind '(normal visual operator) "<C-n>" "motion.down")
(bind '(normal visual operator) "gj" "motion.down")
(bind '(normal visual operator) "k" "motion.up")
(bind '(normal visual operator) "<Up>" "motion.up")
(bind '(normal visual operator) "<C-p>" "motion.up")
(bind '(normal visual operator) "gk" "motion.up")
(bind '(normal visual operator) "w" "motion.word_forward")
(bind '(normal visual operator) "W" "motion.big_word_forward")
(bind '(normal visual operator) "b" "motion.word_backward")
(bind '(normal visual operator) "B" "motion.big_word_backward")
(bind '(normal visual operator) "e" "motion.word_end")
(bind '(normal visual operator) "E" "motion.big_word_end")
(bind '(normal visual operator) "ge" "motion.word_end_backward")
(bind '(normal visual operator) "gE" "motion.big_word_end_backward")
(bind '(normal visual operator) "0" "motion.line_start")
(bind '(normal visual operator) "<Home>" "motion.line_start")
(bind '(normal visual operator) "^" "motion.first_non_blank")
(bind '(normal visual operator) "$" "motion.line_end")
(bind '(normal visual operator) "<End>" "motion.line_end")
(bind '(normal visual operator) "G" "motion.goto_line")
(bind '(normal visual operator) "gg" "motion.goto_first_line")
(bind '(normal visual operator) "f" "motion.find_forward")
(bind '(normal visual operator) "F" "motion.find_backward")
(bind '(normal visual operator) "t" "motion.till_forward")
(bind '(normal visual operator) "T" "motion.till_backward")
(bind '(normal visual operator) ";" "motion.repeat_find")
(bind '(normal visual operator) "," "motion.repeat_find_reverse")
(bind '(normal visual operator) "%" "motion.match_pair")
(bind '(normal visual operator) "}" "motion.paragraph_forward")
(bind '(normal visual operator) "{" "motion.paragraph_backward")
(bind '(normal visual operator) "H" "motion.screen_top")
(bind '(normal visual operator) "M" "motion.screen_middle")
(bind '(normal visual operator) "L" "motion.screen_bottom")
(bind '(normal visual operator) "<C-d>" "motion.half_page_down")
(bind '(normal visual operator) "<C-u>" "motion.half_page_up")
(bind '(normal visual operator) "<C-f>" "motion.page_down")
(bind '(normal visual operator) "<PageDown>" "motion.page_down")
(bind '(normal visual operator) "<C-b>" "motion.page_up")
(bind '(normal visual operator) "<PageUp>" "motion.page_up")
(bind '(normal visual operator) "n" "motion.search_next")
(bind '(normal visual operator) "N" "motion.search_prev")
(bind '(normal visual operator) "*" "motion.word_search_forward")
(bind '(normal visual operator) "#" "motion.word_search_backward")
(bind '(normal visual operator) "+" "motion.next_line")
(bind '(normal visual operator) "<CR>" "motion.next_line")
(bind '(normal visual operator) "-" "motion.prev_line")
(bind '(normal visual operator) "_" "motion.current_line")
(bind '(normal visual operator) "<Bar>" "motion.column")

; Operators.
(bind '(normal visual operator) "d" "operator.delete")
(bind '(normal visual operator) "c" "operator.change")
(bind '(normal visual operator) "y" "operator.yank")
(bind '(normal visual operator) ">" "operator.indent")
(bind '(normal visual operator) "<lt>" "operator.outdent")
(bind '(normal visual operator) "gu" "operator.lowercase")
(bind '(normal visual operator) "gU" "operator.uppercase")
(bind '(normal visual operator) "g~" "operator.toggle_case")
(bind '(normal visual operator) "gc" "operator.comment")

; A register, a mark.
(bind '(normal visual operator) "\"" "register.select")
(bind '(normal visual operator) "'" "motion.mark_line")
(bind '(normal visual operator) "`" "motion.mark")

; From one syntax node to the next.
(bind '(normal visual operator) "]f" "motion.next_function")
(bind '(normal visual operator) "[f" "motion.prev_function")
(bind '(normal visual operator) "]t" "motion.next_type")
(bind '(normal visual operator) "[t" "motion.prev_type")
(bind '(normal visual operator) "]a" "motion.next_argument")
(bind '(normal visual operator) "[a" "motion.prev_argument")
(bind '(normal visual operator) "]c" "motion.next_comment")
(bind '(normal visual operator) "[c" "motion.prev_comment")

; Text objects: `diw`, `va(`.
(bind '(visual operator) "i" "textobj.inner")
(bind '(visual operator) "a" "textobj.around")

; Modes, the selection, and what works on it or on the cursor.
(bind '(normal visual) "<Esc>" "mode.normal")
(bind '(normal visual) "<C-[>" "mode.normal")
(bind '(normal visual) "<C-c>" "mode.normal")
(bind '(normal visual) "v" "mode.visual")
(bind '(normal visual) "V" "mode.visual_line")
(bind '(normal visual) "<C-v>" "mode.visual_block")
(bind '(normal visual) "]x" "select.expand")
(bind '(normal visual) "[x" "select.shrink")
(bind '(normal visual) "@" "macro.play")
(bind '(normal visual) "gv" "visual.reselect")
(bind '(normal visual) "r" "edit.replace_char")
(bind '(normal visual) "J" "edit.join_lines")
(bind '(normal visual) "gJ" "edit.join_lines_no_space")
(bind '(normal visual) "p" "edit.put_after")
(bind '(normal visual) "P" "edit.put_before")
(bind '(normal visual) "<Del>" "edit.delete_char")
(bind '(normal visual) ":" "cmdline.ex")
(bind '(normal visual) "/" "cmdline.search_forward")
(bind '(normal visual) "?" "cmdline.search_backward")

; The view.
(bind '(normal visual) "zz" "view.center")
(bind '(normal visual) "z." "view.center")
(bind '(normal visual) "zt" "view.top")
(bind '(normal visual) "z<CR>" "view.top")
(bind '(normal visual) "zb" "view.bottom")
(bind '(normal visual) "z-" "view.bottom")
(bind '(normal visual) "<C-e>" "view.scroll_down")
(bind '(normal visual) "<C-y>" "view.scroll_up")

; Normal mode: into insert mode, and edits of their own.
(bind 'normal "i" "mode.insert")
(bind 'normal "a" "mode.append")
(bind 'normal "I" "mode.insert_line_start")
(bind 'normal "A" "mode.append_line_end")
(bind 'normal "o" "edit.open_below")
(bind 'normal "O" "edit.open_above")
(bind 'normal "x" "edit.delete_char")
(bind 'normal "X" "edit.delete_char_before")
(bind 'normal "s" "edit.substitute_char")
(bind 'normal "S" "edit.change_lines")
(bind 'normal "Y" "edit.yank_lines")
(bind 'normal "D" "edit.delete_to_line_end")
(bind 'normal "C" "edit.change_to_line_end")
(bind 'normal "~" "edit.toggle_case_char")
(bind 'normal "." "edit.repeat")
(bind 'normal "u" "edit.undo")
(bind 'normal "<C-r>" "edit.redo")
(bind 'normal "m" "mark.set")
(bind 'normal "q" "macro.record")
; `ys`, `ds`, `cs`: the `s` comes after the operator.
(bind 'operator "s" "surround.operator")

; Visual mode.
(bind 'visual "o" "visual.swap_ends")
(bind 'visual "x" "operator.delete")
(bind 'visual "s" "operator.change")
(bind 'visual "u" "operator.lowercase")
(bind 'visual "U" "operator.uppercase")
(bind 'visual "~" "operator.toggle_case")
(bind 'visual "Y" "edit.yank_lines")
(bind 'visual "D" "edit.delete_lines")
(bind 'visual "X" "edit.delete_lines")
(bind 'visual "C" "edit.change_lines")
(bind 'visual "S" "surround.add")
(bind 'visual "I" "visual.insert")
(bind 'visual "A" "visual.append")
(bind 'visual "R" "edit.change_lines")

; Insert mode. What has no binding there is typed as text.
(bind 'insert "<Esc>" "insert.escape")
(bind 'insert "<C-[>" "insert.escape")
(bind 'insert "<C-c>" "insert.escape")
(bind 'insert "<CR>" "insert.newline")
(bind 'insert "<C-j>" "insert.newline")
(bind 'insert "<C-m>" "insert.newline")
(bind 'insert "<BS>" "insert.backspace")
(bind 'insert "<C-h>" "insert.backspace")
(bind 'insert "<Del>" "insert.delete")
(bind 'insert "<Tab>" "insert.tab")
(bind 'insert "<C-w>" "insert.delete_word")
(bind 'insert "<C-u>" "insert.delete_line")
(bind 'insert "<C-t>" "insert.indent")
(bind 'insert "<C-d>" "insert.outdent")
(bind 'insert "<Left>" "insert.left")
(bind 'insert "<Right>" "insert.right")
(bind 'insert "<Up>" "insert.up")
(bind 'insert "<Down>" "insert.down")
(bind 'insert "<PageUp>" "insert.page_up")
(bind 'insert "<PageDown>" "insert.page_down")
(bind 'insert "<Home>" "insert.home")
(bind 'insert "<End>" "insert.end")
